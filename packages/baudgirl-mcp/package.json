{
  "name": "baudgirl-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "EXPERIMENTAL, opt-in. MCP server for the FM-1 running Baud Girl's FM-1+VA firmware. Runs Baud Girl's proprietary JS fetched at runtime only when BAUDGIRL_ALLOW_REMOTE_JS=1.",
  "type": "module",
  "bin": {
    "baudgirl-mcp": "./src/server.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "midi": "^2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "allowScripts": {
    "midi@2.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT"
}
